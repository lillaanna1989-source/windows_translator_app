<Window x:Class="WindowsWritingAssistant.SuggestionWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Windows Writing Assistant" SizeToContent="WidthAndHeight" MinWidth="420" MaxWidth="760"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
 FontFamily="Segoe UI" FontSize="12">
 <Border Background="#F7F9FC" BorderBrush="#D8DFEA" BorderThickness="1" CornerRadius="12" Padding="10">
  <StackPanel>
   <TextBlock Text="Translation style" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,7"/>
   <Border x:Name="NormalRow" CornerRadius="7" Padding="8,6" Margin="0,1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="1" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Normal" FontWeight="SemiBold"/><TextBlock x:Name="NormalText" Grid.Column="2" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
    </Grid>
   </Border>
   <Border x:Name="PoliteRow" CornerRadius="7" Padding="8,6" Margin="0,1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="2" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Polite" FontWeight="SemiBold"/><TextBlock x:Name="PoliteText" Grid.Column="2" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
    </Grid>
   </Border>
   <Border x:Name="WelcomingRow" CornerRadius="7" Padding="8,6" Margin="0,1">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="3" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Welcoming" FontWeight="SemiBold"/><TextBlock x:Name="WelcomingText" Grid.Column="2" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
    </Grid>
   </Border>
   <TextBlock Text="1 / 2 / 3 selects a mode   •   Shift + Enter accepts   •   Default: Polite" Foreground="#667085" Margin="4,7,0,0"/>
  </StackPanel>
 </Border>
</Window>
