<Window x:Class="WindowsWritingAssistant.StatusPopup"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Windows Writing Assistant" Width="280" Height="96" MinHeight="96" SizeToContent="Manual" WindowStyle="ToolWindow"
 Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
 ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
 FontFamily="Segoe UI" FontSize="12">
 <Grid Margin="12,14,12,14" VerticalAlignment="Stretch">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,10,0"/>
  <TextBlock Grid.Column="1" x:Name="Message" VerticalAlignment="Center" TextWrapping="NoWrap" LineStackingStrategy="BlockLineHeight" LineHeight="18"
             Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
 </Grid>
</Window>
