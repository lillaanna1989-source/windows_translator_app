<Window x:Class="WindowsWritingAssistant.OcrResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Screen Translation" Width="470" SizeToContent="Height" MaxHeight="620" WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize" Background="#F7F9FC">
 <Border Padding="20"><StackPanel>
  <TextBlock Text="Screen Translation" FontSize="22" FontWeight="SemiBold"/>
  <TextBlock x:Name="LanguageLine" Margin="0,4,0,14" Foreground="#667085"/>
  <TextBlock Text="Translation" FontWeight="SemiBold"/>
  <Border Background="White" BorderBrush="#D7DFEA" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,6,0,14"><TextBox x:Name="Translated" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="16"/></Border>
  <TextBlock Text="Original OCR text" FontWeight="SemiBold"/>
  <Border Background="#F1F4F8" CornerRadius="7" Padding="10" Margin="0,6,0,14"><TextBox x:Name="Original" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#667085"/></Border>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Copy" Width="90" Height="34" Margin="0,0,8,0" Click="Copy_Click"/><Button Content="Close" Width="90" Height="34" Click="Close_Click"/></StackPanel>
 </StackPanel></Border>
</Window>
