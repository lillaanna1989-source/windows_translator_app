<Window x:Class="WindowsWritingAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Windows Writing Assistant" Icon="Assets/WindowsWritingAssistant.ico" Width="1060" Height="700" MinWidth="930" MinHeight="620" WindowStartupLocation="CenterScreen"
 Background="#F7F9FC" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#0067C0"/><SolidColorBrush x:Key="Text2" Color="#5D6673"/><SolidColorBrush x:Key="Line" Color="#D8DEE8"/>
  <Style x:Key="Nav" TargetType="Button"><Setter Property="Height" Value="46"/><Setter Property="Margin" Value="9,2"/><Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#E6EEF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="115"/><Setter Property="Background" Value="#0067C0"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="CardButton" TargetType="Button"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="20"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F1F7FE"/><Setter TargetName="b" Property="BorderBrush" Value="#9CC8F2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E3F0FC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Toggle" TargetType="CheckBox"><Setter Property="Margin" Value="0,8"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#F2F6FA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><StackPanel Margin="0,18,0,0">
   <TextBlock Text="▦  Writing Assistant" FontSize="17" FontWeight="SemiBold" Margin="22,8,8,18"/>
   <Button Style="{StaticResource Nav}" Click="Home_Click" Content="⌂   Home"/><Button Style="{StaticResource Nav}" Click="TranslateNav_Click" Content="文   Translate"/><Button Style="{StaticResource Nav}" Click="GrammarNav_Click" Content="✓   Grammar"/><Button Style="{StaticResource Nav}" Click="LiveNav_Click" Content="◎   Screen To Translate"/><Button Style="{StaticResource Nav}" Click="WritingHelp_Click" Content="▤   Writing Help"/><Button Style="{StaticResource Nav}" Click="Log_Click" Content="↶   Log"/><Button Style="{StaticResource Nav}" Click="Settings_Click" Content="⚙   Settings"/><Button Style="{StaticResource Nav}" Click="About_Click" Content="ⓘ   About"/>
  </StackPanel></Border>
  <Grid Grid.Column="1" Margin="38,30">
   <StackPanel x:Name="HomePanel"><TextBlock Text="Windows Writing Assistant" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Write, translate, and improve with confidence." FontSize="16" Foreground="{StaticResource Text2}" Margin="0,5,0,28"/>
    <UniformGrid Columns="4">
     <Button Style="{StaticResource CardButton}" Click="TranslateNav_Click" Margin="0,0,10,0"><StackPanel><TextBlock Text="文" FontSize="34" Foreground="#087CD8"/><TextBlock Text="Translate" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Translate text in any application while you type." TextWrapping="Wrap" Foreground="{StaticResource Text2}"/></StackPanel></Button>
     <Button Style="{StaticResource CardButton}" Click="GrammarNav_Click" Margin="0,0,10,0"><StackPanel><TextBlock Text="✓" FontSize="34" Foreground="#087CD8"/><TextBlock Text="Grammar" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Check grammar, spelling, and style while typing." TextWrapping="Wrap" Foreground="{StaticResource Text2}"/></StackPanel></Button>
     <Button Style="{StaticResource CardButton}" Click="WritingHelp_Click" Margin="0,0,10,0"><StackPanel><TextBlock Text="▤" FontSize="34" Foreground="#087CD8"/><TextBlock Text="Writing Help" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="Tips, guidance, and useful shortcuts." TextWrapping="Wrap" Foreground="{StaticResource Text2}"/></StackPanel></Button>
     <Button Style="{StaticResource CardButton}" Click="Log_Click"><StackPanel><TextBlock Text="↶" FontSize="34" Foreground="#087CD8"/><TextBlock Text="Log" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="View your recent translations." TextWrapping="Wrap" Foreground="{StaticResource Text2}"/></StackPanel></Button>
    </UniformGrid>
    <Border Background="#EAF4FF" CornerRadius="7" Padding="16" Margin="0,22,0,0"><TextBlock Text="💡 Tip: Select text anywhere and use Ctrl+Alt+1 Translate • Ctrl+Alt+2 Grammar • Ctrl+Alt+O Open • Ctrl+Alt+L Language • Ctrl+Alt+C Screen translate • Ctrl+T+R Screen To Translate" TextWrapping="Wrap"/></Border>
   </StackPanel>

   <StackPanel x:Name="TranslatePanel" Visibility="Collapsed"><Grid><StackPanel><TextBlock Text="文  Translate" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Translate while typing in other applications." Foreground="{StaticResource Text2}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Disable" Width="90" Height="40" Margin="0,0,10,0" Click="Disable_Click"/><Button Content="Enable Translate" Style="{StaticResource Primary}" Click="EnableTranslate_Click"/></StackPanel></Grid>
    <Border Style="{StaticResource Card}" Margin="0,22,0,0"><StackPanel>
     <TextBlock Text="Target language" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Choose where Windows Writing Assistant should translate your text." Foreground="{StaticResource Text2}" Margin="0,3,0,10"/>
     <TextBox x:Name="TargetLanguage" Text="Japanese" Height="42" Padding="11,8" TextChanged="TargetLanguage_TextChanged"/>
     <TextBlock x:Name="LanguageCorrectionText" Margin="2,8,0,0" FontSize="15" Foreground="{StaticResource Text2}"/><Border x:Name="LanguageCorrectionBox" Visibility="Collapsed"/>
     <Separator Margin="0,18,0,12"/>
     <CheckBox x:Name="ReplaceSelectedText" Style="{StaticResource Toggle}" Content="Replace selected text" IsChecked="True"/><CheckBox x:Name="ShowTranslationPreview" Style="{StaticResource Toggle}" Content="Show translation preview"/>
     <TextBlock Text="Translations are applied to the text field you are using — no translation editor is embedded in this app." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel>

   <StackPanel x:Name="GrammarPanel" Visibility="Collapsed"><Grid><StackPanel><TextBlock Text="✓  Grammar" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Check grammar, spelling, and style while you type." Foreground="{StaticResource Text2}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Disable" Width="90" Height="40" Margin="0,0,10,0" Click="Disable_Click"/><Button Content="Enable Grammar" Style="{StaticResource Primary}" Click="EnableGrammar_Click"/></StackPanel></Grid>
    <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Checks" FontSize="18" FontWeight="SemiBold"/><CheckBox Style="{StaticResource Toggle}" Content="Grammar" IsChecked="True" IsEnabled="False"/><CheckBox Style="{StaticResource Toggle}" Content="Spelling" IsChecked="True" IsEnabled="False"/><CheckBox Style="{StaticResource Toggle}" Content="Clearer wording" IsChecked="True" IsEnabled="False"/><TextBlock Text="Windows Writing Assistant checks the active text field after a short pause so normal typing stays responsive." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Suggestion behavior" FontSize="18" FontWeight="SemiBold"/><CheckBox Style="{StaticResource Toggle}" Content="Replace selected text" IsChecked="{Binding IsChecked, ElementName=ReplaceSelectedText, Mode=TwoWay}"/><CheckBox Style="{StaticResource Toggle}" Content="Show suggestion preview" IsChecked="{Binding IsChecked, ElementName=ShowTranslationPreview, Mode=TwoWay}"/><TextBlock Text="Press Shift+Enter to accept a suggestion when one is shown." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="LivePanel" Visibility="Collapsed">
    <TextBlock Text="◎  Screen To Translate" FontSize="29" FontWeight="SemiBold"/>
    <Border Background="#33383E" CornerRadius="8" Padding="12" Margin="0,10,0,10"><StackPanel><TextBlock Text="LIVE STATUS / DIAGNOSTICS" Foreground="White" FontWeight="Bold"/><TextBlock x:Name="LiveStatusTop" Text="Stopped — click Start LIVE" Foreground="White" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="Test text-only caption (no OCR or internet)" Click="TestCaption_Click" Margin="0,9,0,0" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Text="Translate changing text on screen or transcribe microphone speech." Foreground="{StaticResource Text2}" Margin="0,5,0,20"/>
    <Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="Screen To Translate" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Translate into" Margin="0,10,0,4" FontWeight="SemiBold"/>
      <ComboBox x:Name="LiveTarget" SelectedIndex="0" Height="34">
       <ComboBoxItem Content="English"/><ComboBoxItem Content="Hungarian"/><ComboBoxItem Content="Spanish"/><ComboBoxItem Content="French"/><ComboBoxItem Content="German"/><ComboBoxItem Content="Japanese"/><ComboBoxItem Content="Portuguese"/><ComboBoxItem Content="Italian"/><ComboBoxItem Content="Korean"/><ComboBoxItem Content="Chinese"/>
      </ComboBox>
      <TextBlock Text="Languages I understand (comma-separated; never translate these)" Margin="0,10,0,4" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <TextBox x:Name="KnownLanguages" Text="English" Height="34" Padding="8,5" ToolTip="For example: English, Hungarian"/>
      <CheckBox x:Name="OnlyForeign" Content="Skip text already in my target or known languages" IsChecked="True" Margin="0,10,0,10"/>
      <Button Style="{StaticResource Primary}" Content="Start LIVE full-screen translation" Click="LiveFullScreen_Click" Margin="0,0,0,8"/>

      <TextBlock Text="Full-screen scanning starts immediately, without selecting a rectangle. Grey captions are positioned beside detected lines and move as the screen scrolls. Ctrl+T+R toggles live translation." TextWrapping="Wrap" Margin="0,8,0,12"/>
      <StackPanel Orientation="Horizontal"><Button Style="{StaticResource Primary}" Content="Start LIVE (no rectangle)" Click="LiveStart_Click"/><Button Content="Stop live screen" Margin="10,0,0,0" Click="LiveStop_Click"/></StackPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
      <TextBlock Text="Live microphone transcription" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Uses installed Windows speech recognition and your default microphone. Not system audio; recognition language depends on Windows speech packs." TextWrapping="Wrap" Margin="0,8,0,12"/>
      <StackPanel Orientation="Horizontal"><Button Style="{StaticResource Primary}" Content="Start microphone" Click="MicStart_Click"/><Button Content="Stop microphone" Margin="10,0,0,0" Click="MicStop_Click"/></StackPanel>
      <TextBox x:Name="TranscriptBox" Margin="0,12,0,0" Height="115" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" AcceptsReturn="True"/>
    </StackPanel></Border>
    <TextBlock x:Name="LiveStatus" Text="Live tools are stopped" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource Text2}"/>
   </StackPanel>

   <StackPanel x:Name="WritingPanel" Visibility="Collapsed"><TextBlock Text="▤  Writing Help" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Tips, examples, and guidance for better writing." Foreground="{StaticResource Text2}" Margin="0,5,0,22"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Write clearly" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use short, simple sentences when clarity matters." Margin="0,7,0,18"/><TextBlock Text="Be specific" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Concrete details make your writing stronger." Margin="0,7,0,18"/><TextBlock Text="Avoid repetition" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Vary repeated words when it improves readability." Margin="0,7,0,0"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Shortcuts" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Ctrl+Alt+1   Translate\nCtrl+Alt+2   Grammar\nCtrl+Alt+O   Open assistant\nCtrl+Alt+L   Choose language\nCtrl+Alt+C   Screen translate\nShift+Enter   Accept suggestion" Margin="0,10,0,0" LineHeight="29"/><TextBlock Text="Windows Writing Assistant works in supported editable fields outside this window." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="LogPanel" Visibility="Collapsed"><Grid><StackPanel><TextBlock Text="↶  Translation Log" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Recent translations from this session." Foreground="{StaticResource Text2}" Margin="0,5,0,0"/></StackPanel><Button Content="Clear All" HorizontalAlignment="Right" Width="95" Height="34" Click="ClearLog_Click"/></Grid><Border Style="{StaticResource Card}" Padding="0" Margin="0,20,0,0"><ListView x:Name="TranslationLog" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Time" Width="85" DisplayMemberBinding="{Binding Time}"/><GridViewColumn Header="To" Width="120" DisplayMemberBinding="{Binding To}"/><GridViewColumn Header="Original" Width="220" DisplayMemberBinding="{Binding Original}"/><GridViewColumn Header="Translation" Width="260" DisplayMemberBinding="{Binding Translation}"/></GridView></ListView.View></ListView></Border></StackPanel>

   <StackPanel x:Name="SettingsPanel" Visibility="Collapsed"><TextBlock Text="⚙  Settings" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Customize Windows Writing Assistant to fit your workflow." Foreground="{StaticResource Text2}" Margin="0,5,0,22"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Application" FontSize="18" FontWeight="SemiBold"/><CheckBox Style="{StaticResource Toggle}" Content="Minimize to system tray" IsChecked="True"/><CheckBox Style="{StaticResource Toggle}" Content="Keep global shortcuts active" IsChecked="True" IsEnabled="False"/><CheckBox Style="{StaticResource Toggle}" Content="Show status notifications"/><Button Content="Disable Assistant" Height="38" Margin="0,12,0,0" Click="Disable_Click"/><Separator Margin="0,12"/><TextBlock Text="Shortcuts" FontWeight="SemiBold"/><TextBlock Text="Ctrl+Alt+1  Translate\nCtrl+Alt+2  Grammar\nCtrl+Alt+O  Open\nCtrl+Alt+L  Language\nCtrl+Alt+C  Screen translate" Foreground="{StaticResource Text2}" Margin="0,8,0,0" LineHeight="24"/></StackPanel></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Default options" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Default mode" Margin="0,14,0,6"/><ComboBox x:Name="ModeSelect" Height="38" SelectedIndex="1" SelectionChanged="ModeSelect_SelectionChanged"><ComboBoxItem Content="Grammar"/><ComboBoxItem Content="Translate"/></ComboBox><CheckBox Style="{StaticResource Toggle}" Content="Replace selected text by default" IsChecked="{Binding IsChecked, ElementName=ReplaceSelectedText, Mode=TwoWay}" Margin="0,16,0,4"/><CheckBox Style="{StaticResource Toggle}" Content="Show preview by default" IsChecked="{Binding IsChecked, ElementName=ShowTranslationPreview, Mode=TwoWay}"/><TextBlock Text="Target language is configured on the Translate page." Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border>
    </Grid>
   </StackPanel>

   <StackPanel x:Name="AboutPanel" Visibility="Collapsed"><TextBlock Text="ⓘ  About" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Information about Windows Writing Assistant." Foreground="{StaticResource Text2}" Margin="0,5,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="▦  Windows Writing Assistant" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Version 10.3 live beta" Margin="0,7,0,15" Foreground="{StaticResource Text2}"/><TextBlock Text="A lightweight writing utility for translation and grammar assistance across supported editable fields." TextWrapping="Wrap" MaxWidth="620"/><TextBlock Text="Windows-inspired third-party utility. Not affiliated with or made by Microsoft." FontWeight="SemiBold" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
  </Grid>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><TextBlock x:Name="Status" Text="● Ready" VerticalAlignment="Center"/><TextBlock Text="Windows Writing Assistant • v10.3 live beta" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/></Grid></Border>
 </Grid>
</Window>
