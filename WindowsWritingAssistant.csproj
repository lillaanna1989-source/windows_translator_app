<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowsWritingAssistant</AssemblyName>
    <RootNamespace>WindowsWritingAssistant</RootNamespace>
    <ApplicationIcon>Assets\WindowsWritingAssistant.ico</ApplicationIcon>
    <Product>Windows Writing Assistant</Product>
    <Description>Writing Assistant for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\WindowsWritingAssistant.ico" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>
</Project>
